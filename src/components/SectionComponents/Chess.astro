---
const username = "red00003";

const response = await fetch(
    `https://api.chess.com/pub/player/${username}/stats`,
    {
        headers: {
            "User-Agent": "Astro Chess Ratings",
        },
    },
);

if (!response.ok) {
    throw new Error(`Chess.com API returned ${response.status}`);
}

const stats = await response.json();

const ratings = [
    {
        name: "Rapid",
        rating: stats.chess_rapid?.last?.rating,
    },
    {
        name: "Blitz",
        rating: stats.chess_blitz?.last?.rating,
    },
    {
        name: "Bullet",
        rating: stats.chess_bullet?.last?.rating,
    },
];
---

<section>
    <div class="flex gap-2">
        <h2>
            <a
                href="https://www.chess.com/member/red00003"
                target="_blank"
                class=""
            >
                Chess.com:
            </a>{" "}
        </h2>
        {ratings.map(({ name, rating }) => (
            <div class="flex flex-row gap-1">
                <span>{name}</span>
                <strong>{rating ?? "—"}</strong>
            </div>
        ))}
    </div>
</section>
