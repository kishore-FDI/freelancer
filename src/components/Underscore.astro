---
interface Props {
    color?: string;
}

const { color = "#f3a6c5" } = Astro.props;
---

<span class="hand-highlight">
    <span class="hand-highlight__text">
        <slot />
    </span>

    <!-- Marker behind text -->
    <svg
        class="hand-highlight__marker"
        viewBox="0 0 100 30"
        preserveAspectRatio="none"
        aria-hidden="true"
    >
        <path d="M3 16 C25 12, 48 17, 72 14 S91 14, 97 16" />
    </svg>

    <!-- Hand-drawn underline -->
    <svg
        class="hand-highlight__underline"
        viewBox="0 0 100 20"
        preserveAspectRatio="none"
        aria-hidden="true"
    >
        <path d="M3 12 C25 8, 55 9, 97 5" />
    </svg>
</span>

<style>
    .hand-highlight {
        --highlight-color: #f3a6c5;

        position: relative;
        display: inline-block;
        isolation: isolate;
        white-space: nowrap;
    }

    .hand-highlight__text {
        position: relative;
        z-index: 2;
    }

    /* PINK HIGHLIGHT */
    .hand-highlight__marker {
        position: absolute;
        z-index: 1;

        left: -3%;
        top: 50%;

        width: 106%;
        height: 1.15em;

        transform: translateY(-50%);

        overflow: visible;
        pointer-events: none;
    }

    .hand-highlight__marker path {
        fill: none;
        stroke: var(--highlight-color);
        stroke-width: 13;
        stroke-linecap: round;
        opacity: 0.55;
    }

    /* BLACK HAND-DRAWN LINE */
    .hand-highlight__underline {
        position: absolute;
        z-index: 3;

        left: 1%;
        bottom: -0.55em;

        width: 98%;
        height: 0.65em;

        overflow: visible;
        pointer-events: none;
    }

    .hand-highlight__underline path {
        fill: none;
        stroke: #111;
        stroke-width: 4;
        stroke-linecap: round;
    }
</style>
