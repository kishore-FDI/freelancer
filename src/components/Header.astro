---
import { SITE_TITLE, NAVBAR_ITEMS } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="w-full border-b border-black/10 bg-white">
	<nav class="max-w-5xl mx-auto px-6 py-4 flex items-center justify-between font-hand">
		<a href="/" class="text-xl sm:text-2xl md:text-4xl font-bold tracking-tight text-black hover:opacity-70 transition-opacity">
			{SITE_TITLE}
		</a>
		<ul class="flex items-center gap-3 sm:gap-5 md:gap-6 list-none m-0 p-0">
			{Object.entries(NAVBAR_ITEMS).map(([label, path]) => (
				<li>
					<HeaderLink href={`/${path}`} class="text-sm sm:text-base md:text-2xl text-black no-underline hover:opacity-60 transition-opacity [&.active]:underline [&.active]:underline-offset-4">
						{label}
					</HeaderLink>
				</li>
			))}
		</ul>
	</nav>
</header>
